import pandas as pd
from google.colab import files
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt

# -------------------------------
# STEP 1: Upload Dataset
# -------------------------------
uploaded = files.upload()
file_path = list(uploaded.keys())[0]
df = pd.read_csv(file_path)

print("\nColumns in dataset:\n", df.columns)
print("\nDataset Preview:\n", df.head())

# -------------------------------
# STEP 2: Select Feature Columns
# -------------------------------
col1 = input("\nEnter first feature column name: ")
col2 = input("Enter second feature column name: ")

X = df[[col1, col2]].dropna()

# -------------------------------
# STEP 3: Scaling
# -------------------------------
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# -------------------------------
# STEP 4: Choose number of clusters
# -------------------------------
k = int(input("\nEnter number of clusters (k): "))

# -------------------------------
# STEP 5: K-Means
# -------------------------------
kmeans = KMeans(n_clusters=k, random_state=42)
y_kmeans = kmeans.fit_predict(X_scaled)

# -------------------------------
# STEP 6: Plot
# -------------------------------
plt.figure()

for i in range(k):
    plt.scatter(
        X.iloc[y_kmeans == i, 0],
        X.iloc[y_kmeans == i, 1],
        label=f'Cluster {i}'
    )

# Centroids
centroids = scaler.inverse_transform(kmeans.cluster_centers_)

plt.scatter(
    centroids[:, 0],
    centroids[:, 1],
    s=200,
    c='black',
    label='Centroids'
)

plt.xlabel(col1)
plt.ylabel(col2)
plt.title('K-Means Clustering')
plt.legend()
plt.show()
